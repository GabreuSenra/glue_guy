@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent

<root>
    <div class="leaderboard-card">
        <div class="stat-row">
            <label class="title">MOVES: </label>
            <span class="value">@GetMoves()</span>
        </div>
        
        <div class="divider"></div>
        
        <div class="stat-row">
            <label class="title">TIME: </label>
            <span class="value">@FormatTime()</span>
        </div>
    </div>
</root>

@code {
    [Property] public LiderBoard MeuLiderBoard { get; set; }

    protected override void OnStart()
    {
        MeuLiderBoard = Scene.GetAllComponents<LiderBoard>().FirstOrDefault();
    }

    string GetMoves()
    {
        if (MeuLiderBoard == null) return "0";
        return MeuLiderBoard.GetMoveCount().ToString();
    }

    string FormatTime()
    {
        if (MeuLiderBoard == null) return "00:00";
        var time = TimeSpan.FromSeconds(MeuLiderBoard.GetElapsedTime());
        return $"{(int)time.TotalMinutes:00}:{time.Seconds:00}";
    }

    protected override int BuildHash()
    {
        if (MeuLiderBoard == null) return 0;
        return System.HashCode.Combine( MeuLiderBoard.GetMoveCount(), MeuLiderBoard.GetElapsedTime() );
    }
}