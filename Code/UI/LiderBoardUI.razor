@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent

<root>
    <div class="leaderboard-card">
        <div class="stat-row">
            <label class="title">MOVIMENTOS: </label>
            <span class="value">@GetMoves()</span>
        </div>
        
        <div class="divider"></div>
        
        <div class="stat-row">
            <label class="title">TEMPO: </label>
            <span class="value">@FormatTime()</span>
        </div>
    </div>
</root>

@code {
    [Property] public LiderBoard MeuLiderBoard { get; set; }

    string GetMoves()
    {
        if (MeuLiderBoard == null) return "0";
        return MeuLiderBoard.movecont.ToString();
    }

    string FormatTime()
    {
        if (MeuLiderBoard == null) return "00:00";
        var time = TimeSpan.FromSeconds(MeuLiderBoard.elapsedtime);
        return $"{(int)time.TotalMinutes:00}:{time.Seconds:00}";
    }

    protected override int BuildHash()
    {
        if (MeuLiderBoard == null) return 0;
        return System.HashCode.Combine( MeuLiderBoard.movecont, MeuLiderBoard.elapsedtime );
    }
}